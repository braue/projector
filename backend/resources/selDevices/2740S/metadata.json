  "part_number": {
    "model": "2740S",
    "product": "SEL-2740S Software-Defined Network (SDN) Switch",
    "length": null,
    "prefix": {
      "positions": null,
      "value": "SEL-2740S",
      "description": "SEL-2740S Software-Defined Network Switch base chassis (six interface slots A-F, two power-supply slots)"
    },
    "note": "No per-digit configurable Model Option Table. The SEL-2740S is a build-to-suit modular chassis: it is ordered as a base chassis plus separately ordered SEL-9620-series interface modules and SEL-9330-series power supplies, so there is no digit-encoded part number to decode (positions is empty). Slot A must hold the SEL-9620-0007 alarm-contact/SDN flow-processor (coprocessor) module for the switch to operate; Ethernet modules (SEL-9620-00xx) populate Slots B-F. Interface modules from Table 3 of the instruction manual: SEL-9620-0007 (alarm contact and coprocessor, Slot A), SEL-9620-0008 (10/100/1000BASE-T RJ45), SEL-9620-0019 (100BASE-FX multimode), SEL-9620-0020 (1000BASE-LX single-mode), SEL-9620-0023 (1000BASE-SX multimode), SEL-9620-0026 (100BASE-LX10 single-mode), SEL-9620-0029 (1000BASE-EX single-mode), SEL-9620-0031 (10BASE-FL), SEL-9620-0037 (2-port 1000BASE-SX + 2-port 10/100/1000 copper), SEL-9620-0041 (2-port 1000BASE-LX + 2-port 10/100/1000 copper), SEL-9620-0044 (1-port 1000BASE-LX + 3-port 1000BASE-SX). Power supplies: SEL-9330A (110-240 Vac / 88-300 Vdc) and SEL-9330C (24-48 Vdc). Conformal-coating variants use different part numbers; an optional surface-mount kit is part number 915900533.",
    "references": [
      "SEL-2740S Software-Defined Network Switch Instruction Manual (2740S_IM_20240501), Table 3 Interface Modules and Power Supply section",
      "SEL-2740S product page (selinc.com/products/2740S)"
    ],
    "positions": []
  }
