  "part_number": {
    "model": "3555",
    "product": "SEL-3555 Real-Time Automation Controller (RTAC)",
    "length": null,
    "prefix": {
      "positions": "1-8",
      "value": "SEL-3555",
      "description": "SEL-3555 / SEL-3555-2 Real-Time Automation Controller (RTAC), an x86-64 industrial computer platform"
    },
    "note": "No configurable Model Option Table / per-digit part number. The SEL-3555 is a build-to-order industrial computer (RTAC): it is quoted and configured by selecting options (CPU, 8-64 GB RAM, up to 4 SATA SSDs, up to 4 PCI expansion cards - SEL-3390E4 Ethernet / SEL-3390S8 Serial / SEL-3390T Time+Ethernet, 3U rack or panel mount, one or two hot-swappable 48 Vdc / 125-250 Vdc / 120-240 Vac power supplies, and optional conformal coating), not by a fixed digit string. The SEL-3555-2 Instruction Manual states directly: \"This manual does not provide complete ordering information. For complete information, see the latest SEL-3555-2 model options at selinc.com.\" The SEL-3555-2 data sheet contains no Ordering Information / Model Option Table figure. No genuine digit-string part number exists to calibrate positions against, so no positions are emitted.",
    "references": [
      "SEL-3555-2 Data Sheet (3555-2_DS_20250730, Date Code 20250730) - no ordering-information / model-option-table figure",
      "SEL-3555-2 RTAC Instruction Manual (3555-2_IM_20250730_20260313), Introduction and Specifications > Models, Options, and Accessories - defers ordering to selinc.com model options",
      "No SEL-3555 ordering-information (WI-) Model Option Table document exists in the SEL doc index (only accessory cable/adapter and SEL-3390x card ordering docs)"
    ],
    "positions": []
  }
