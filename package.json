{
  "name": "projector",
  "productName": "Projector",
  "version": "0.24.0",
  "description": "Settings-truth communications canvas for substation automation.",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "license": "ISC",
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "app": "npm run build && electron .",
    "app:dev": "electron .",
    "dist": "node tools/patch-nsis-uninstaller.mjs && npm run build && electron-builder --win",
    "dist:dir": "node tools/patch-nsis-uninstaller.mjs && npm run build && electron-builder --win --dir",
    "sel:index": "node tools/build-sel-index.mjs",
    "check:registry": "node tools/check-registry.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version"
  },
  "devDependencies": {
    "electron": "^43.8.8",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.braue.projector",
    "productName": "Projector",
    "copyright": "Copyright © Nathan Braue",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asarUnpack": [
      "backend/py/**",
      "backend/node_modules/tesseract.js/**",
      "backend/node_modules/tesseract.js-core/**",
      "backend/node_modules/@tesseract.js-data/**",
      "backend/node_modules/wasm-feature-detect/**",
      "backend/node_modules/bmp-js/**",
      "backend/node_modules/regenerator-runtime/**",
      "backend/node_modules/is-url/**",
      "backend/node_modules/zlibjs/**",
      "backend/node_modules/node-fetch/**",
      "backend/node_modules/whatwg-url/**",
      "backend/node_modules/tr46/**",
      "backend/node_modules/webidl-conversions/**"
    ],
    "extraResources": [
      {
        "from": "sel_fulltext.sqlite",
        "to": "sel_fulltext.sqlite"
      }
    ],
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "!backend/data/**",
      "!backend/test/**",
      "!**/*.map",
      "!**/{.eslintrc,.editorconfig,.prettierrc,tsconfig.json,*.md}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Projector",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Projector-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  },
  "allowScripts": {
    "electron-winstaller": false,
    "electron": true
  }
}
